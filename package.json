  "files": ["index.mjs", "quota.mjs", "discover.mjs", "README.md", "LICENSE", "NOTICE"],
  "keywords": ["magpie-plugin", "opencode", "opencode-plugin", "volcengine", "ark", "coding-plan"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DokiDoki1103/magpie-volcengine-plan.git"
  },
  "scripts": {
    "test": "node test/plugin.test.mjs && node test/quota.test.mjs && node test/discover.test.mjs && node test/scripts.test.mjs && node test/package.test.mjs"
  },
  "magpie": {
    "name": "火山方舟订阅",
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 4,
    "summary": {
      "en": "Volcengine Ark plan (Agent/Coding) over the Anthropic API. Give it just an AccessKey: it finds the plan, API key, quota and expiry. Pauses an account on quota 429 until reset.",
      "zh": "火山方舟订阅（Agent / Coding Plan，Anthropic 协议）：只填 AccessKey 就自动识别套餐、取 API key、读额度和到期；429 额度用尽自动暂停到恢复时间。"
    }
  }
}
